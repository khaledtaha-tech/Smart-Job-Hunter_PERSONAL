{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "hostinger/**/*.ts", "hostinger/**/*.tsx"],
  "exclude": ["node_modules", "hostinger-dist", "releases"]
}
